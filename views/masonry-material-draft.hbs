<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Черновик</title>
  <link rel="stylesheet" href="/css/masonry-material-style.css">
</head>
<body>
  <div class="masonry-material-screen">
    <h1 class="masonry-material-form__title">Черновик</h1>

    {{#if (eq mode "create")}}
      <form class="masonry-material-form__section" action="/masonry-material/draft/next" method="post">
        <label class="masonry-material-form__label" for="masonry-material-name-input">Название</label>
        <input class="masonry-material-form__input" type="text" name="name"
               id="masonry-material-name-input" required>

        <label class="masonry-material-form__label" for="masonry-material-image-input">Изображение</label>
        <div class="masonry-material-file-field">
          <input type="file" accept="image/*" id="masonry-material-image-input"
                 class="masonry-material-file-input" required>
          <img class="masonry-material-file-preview"
               src="/img/masonry-material-default-image.jpg" alt="Предпросмотр изображения">
        </div>

        <label class="masonry-material-form__label" for="masonry-material-video-input">Видео</label>
        <div class="masonry-material-file-field">
          <input type="file" accept="video/*" id="masonry-material-video-input"
                 class="masonry-material-file-input" required>
          <img class="masonry-material-file-preview"
               src="/img/masonry-material-default-video-preview.png" alt="Предпросмотр видео">
        </div>

        <button class="masonry-material-btn masonry-material-btn--search" type="submit" style="margin-top:16px;">Далее</button>
      </form>
    {{else}}
      <form class="masonry-material-form__section" action="/masonry-material/publish" method="post">
        <input type="hidden" name="id" value="{{item.id}}">

        <label class="masonry-material-form__label">Название</label>
        <input class="masonry-material-form__input" type="text" value="{{item.name}}" readonly>

        <label class="masonry-material-form__label" for="masonry-material-description-input">Краткое описание</label>
        <textarea class="masonry-material-form__textarea" name="shortDescription"
                  id="masonry-material-description-input" required></textarea>

        <label class="masonry-material-form__label" for="masonry-material-mortar-input">Раствор на 1 м³ (в м³)</label>
        <input class="masonry-material-form__input" type="number" name="mortarPerM3"
               id="masonry-material-mortar-input" min="0" step="0.001" required>

        <label class="masonry-material-form__label" for="masonry-material-consumption-input">Расход (в шт./м³)</label>
        <input class="masonry-material-form__input" type="number" name="consumptionPerM3"
               id="masonry-material-consumption-input" min="0" step="1" required>

        <button class="masonry-material-btn masonry-material-btn--search" type="submit" style="margin-top:16px;">Опубликовать</button>
      </form>
    {{/if}}

    {{> masonry_material_tabbar}}
  </div>
</body>
</html>
