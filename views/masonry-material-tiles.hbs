<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Плитка — Кладочные материалы</title>
  <link rel="stylesheet" href="/css/masonry-material-style.css">
</head>
<body>
  <div class="masonry-material-screen">
    <h1 class="masonry-material-tiles__title">Фильтрация: расход (в шт./м³) до</h1>

    <form class="masonry-material-tiles__search" action="/masonry-material/tiles" method="get">
      <input
        class="masonry-material-tiles__search-input"
        type="range"
        id="masonry-material-consumption-range"
        name="search"
        min="0"
        max="400"
        step="1"
        value="{{search}}">
      <output class="masonry-material-tiles__search-value"
              for="masonry-material-consumption-range">{{search}}</output>
      <button class="masonry-material-btn masonry-material-btn--search" type="submit">Найти</button>
    </form>

    <div class="masonry-material-tiles__grid">
      {{#each items}}
        <div class="masonry-material-card-wrapper">
          <a href="/masonry-material/feed/{{this.id}}" class="masonry-material-card">
            {{#if this.imageUrl}}
              <object class="masonry-material-card__image" data="{{this.imageUrl}}">
                <img class="masonry-material-card__image" src="/img/masonry-material-default-image.jpg" alt="{{this.name}}">
              </object>
            {{else}}
              <img class="masonry-material-card__image" src="/img/masonry-material-default-image.jpg" alt="{{this.name}}">
            {{/if}}
            <div class="masonry-material-card__name">{{this.name}}</div>
            <div class="masonry-material-card__consumption">Расход (в шт./м³): {{this.consumptionPerM3}}</div>
            <div class="masonry-material-card__likes">❤ {{this.likesCount}}</div>
          </a>
          <form class="masonry-material-card__delete" action="/masonry-material/delete" method="post">
            <input type="hidden" name="id" value="{{this.id}}">
            <button type="submit" class="masonry-material-card__delete-btn" aria-label="Удалить">✕</button>
          </form>
        </div>
      {{/each}}
    </div>

    {{> masonry_material_tabbar}}
  </div>
</body>
</html>
